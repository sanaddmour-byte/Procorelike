# Postgres — superuser connection, used ONLY by packages/db migrate/seed
# scripts and by apps/api's narrow pre-auth lookups (login-by-email, invite
# token lookup, refresh-token lookup) that must run before an RLS session
# context can exist. See docs/ARCHITECTURE.md §3.
DATABASE_URL=postgres://siteops:siteops@localhost:5432/siteops

# Postgres — non-superuser `siteops_app` role (created by
# packages/db/src/sql/001_rls_and_functions.sql), used by apps/api for
# everything else so Row-Level Security is actually enforced, not bypassed.
DATABASE_URL_APP=postgres://siteops_app:siteops_app@localhost:5432/siteops

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Invite / password-reset tokens
INVITE_TOKEN_SECRET=dev-invite-secret-change-me

# Shared secret an external cron presents to POST /internal/rfi-overdue-check
INTERNAL_JOB_SECRET=dev-internal-job-secret-change-me

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=siteops-attachments
S3_ACCESS_KEY_ID=siteops
S3_SECRET_ACCESS_KEY=siteops123
S3_FORCE_PATH_STYLE=true

# Mail (MailHog locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@siteops.local

# apps/api
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
