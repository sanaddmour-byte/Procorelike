{
  "name": "@siteops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@siteops/shared": "workspace:*",
    "@siteops/db": "workspace:*",
    "express": "5.0.1",
    "cors": "2.8.5",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "otpauth": "9.3.6",
    "zod": "3.24.1",
    "drizzle-orm": "0.38.3",
    "@aws-sdk/client-s3": "3.716.0",
    "@aws-sdk/s3-request-presigner": "3.716.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/cors": "2.8.17",
    "@types/jsonwebtoken": "9.0.7",
    "@types/supertest": "6.0.2",
    "@types/node": "22.10.5",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
