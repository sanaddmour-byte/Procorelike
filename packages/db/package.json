{
  "name": "@siteops/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo '@siteops/db: no build step, consumed as TS source' ",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@siteops/shared": "workspace:*",
    "drizzle-orm": "0.38.3",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.30.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
