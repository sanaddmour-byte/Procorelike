{
  "name": "siteops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @siteops/db generate",
    "db:migrate": "pnpm --filter @siteops/db migrate",
    "db:seed": "pnpm --filter @siteops/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@parcel/watcher", "@swc/core"],
    "packageExtensions": {
      "@radix-ui/react-slot": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "expo-router": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "expo": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      }
    }
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "prettier": "3.4.2",
    "eslint": "9.17.0",
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.19.1",
    "eslint-config-prettier": "9.1.0"
  }
}
